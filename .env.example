# Optional. Without a key the app runs in clearly labelled mock mode and spends nothing.
# AI_API_KEY takes precedence; OPENAI_API_KEY is supported for convenience.
AI_API_KEY=
# OPENAI_API_KEY=

# Optional OpenAI-compatible chat-completions endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Demo switches. Never set FORCE_MODEL_FAILURE in production.
MOCK_MODE=0
FORCE_MODEL_FAILURE=0
